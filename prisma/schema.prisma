// Villa ONLY VIEW — data model
// Ported and modernized from the legacy PHP version.
//
// Runs on PostgreSQL — typically the same `onlyview` database as the legacy
// PHP site: the tables here are quoted PascalCase ("Reservation", "Client"…)
// so they coexist with the legacy lowercase tables (reservations, clients…)
// without touching them. `scripts/migrate-legacy.mjs` copies legacy → new.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── Admin users

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  email              String    @unique
  passwordHash       String
  firstname          String?
  lastname           String?
  /// owner | manager | viewer
  role               String    @default("viewer")
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLogin          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String?
  entityId   Int?
  details    String? // JSON
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────── Clients

model Client {
  id              Int      @id @default(autoincrement())
  /// id of the row this was imported from in the legacy PHP schema
  legacyId        Int?
  firstname       String
  lastname        String
  email           String?  @unique
  phone           String?
  country         String?
  language        String   @default("en")
  address         String?
  city            String?
  postalCode      String?
  notes           String?
  /// standing discount granted to this client, in %
  discountPercent Float    @default(0)
  discountReason  String?
  isVip           Boolean  @default(false)
  blacklisted     Boolean  @default(false)
  blacklistReason String?
  tags            String?
  source          String   @default("direct")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservations Reservation[]
  loyalty      LoyaltyAccount?
  authTokens   ClientAuthToken[]

  @@index([legacyId])
}

/// Passwordless login for the guest portal (magic links)
model ClientAuthToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ────────────────────────────────────────────────────────────────── Agencies

model Agency {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  code              String?  @unique
  contactName       String?
  email             String?
  phone             String?
  commissionPercent Float    @default(15)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())

  reservations Reservation[]
}

// ────────────────────────────────────────────────────────────── Reservations

model Reservation {
  id       Int    @id @default(autoincrement())
  /// id of the row this was imported from in the legacy PHP schema
  legacyId Int?
  /// option | confirmed | pending | cancelled | blocked
  status   String @default("option")

  startDate DateTime
  endDate   DateTime

  clientId   Int?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// denormalized display name (kept even if client record is removed)
  clientName String?
  email      String?
  phone      String?

  bedrooms Int @default(4)
  guests   Int @default(8)

  agencyId         Int?
  agency           Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  /// commission % charged by the agency on this reservation (copied at creation)
  agencyFeePercent Float   @default(0)

  // ── Pricing options (ported from the PHP admin) ──
  /// per-stay override of the weekly rate (friend rate on mixed-season stays)
  customWeeklyRate   Float?
  /// manual final price HT — overrides every calculation when set
  finalPriceOverride Float?
  /// computed price HT at last save (source of truth for reports)
  priceHT            Float   @default(0)
  taxAmount          Float   @default(0)
  priceTTC           Float   @default(0)
  discountPercent    Float   @default(0)
  /// "offer 1 bedroom": bill n-1 bedrooms (4→3, 3→2)
  offerOneRoom       Boolean @default(false)
  freeNights         Int     @default(0)
  /// offer the 5% tourist tax
  noTax              Boolean @default(false)
  promoCode          String?

  // ── Option handling ──
  optionExpires DateTime?

  // ── Payments ──
  /// expected deposit (defaults to 30% of TTC for direct bookings)
  depositAmount   Float     @default(0)
  depositReceived Boolean   @default(false)
  balanceReceived Boolean   @default(false)
  payments        Payment[]

  // ── Stay details ──
  earlyCheckin  Boolean @default(false)
  arrivalTime   String?
  lateCheckout  Boolean @default(false)
  departureTime String?
  notes         String?

  // ── Guest details (filled by the guest in the portal, or by the admin) ──
  arrivalFlight         String?
  /// estimated arrival time at the villa (the guest's own estimate)
  arrivalEta            String?
  departureFlight       String?
  departureEta          String?
  adults                Int?
  children              Int?
  /// one guest per line
  guestNames            String?
  /// allergies, celebrations, special needs…
  specialRequests       String?
  guestDetailsUpdatedAt DateTime?

  // ── Guest communication ──
  /// booking confirmation email sent to the client (opt-in when confirming)
  confirmationEmailSent Boolean @default(false)
  portalToken           String? @unique
  portalEmailSent       Boolean @default(false)

  // ── Lifecycle ──
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  periods             ReservationPeriod[]
  contracts           Contract[]
  loyaltyTransactions LoyaltyTransaction[]
  bookingRequest      BookingRequest?
  extras              ReservationExtra[]
  reminders           ReminderLog[]
  dateChanges         DateChange[]

  @@index([startDate, endDate])
  @@index([status])
  @@index([legacyId])
}

/// Variable bedrooms / custom rate per period inside a single stay
/// ("Chambres variables par période" in the PHP admin).
model ReservationPeriod {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  bedrooms      Int         @default(4)
  /// weekly rate override for this period; null = seasonal rate
  weeklyRate    Float?
  sortOrder     Int         @default(0)

  @@index([reservationId])
}

/// Money actually received — the finance ledger.
model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  /// deposit | balance | extra | refund
  kind          String      @default("deposit")
  amount        Float
  currency      String      @default("USD")
  /// wire | card | cash | check | other
  method        String      @default("wire")
  receivedAt    DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@index([receivedAt])
}

// ──────────────────────────────────────────────────────────────────── Extras

/// Catalog of services offered on top of the rental (chef, car, boat…).
model Extra {
  id            Int             @id @default(autoincrement())
  nameEn        String
  nameFr        String
  descriptionEn String?
  descriptionFr String?
  /// per unit below, in USD — or in the provider's currency when a
  /// provider supplies it (then paid to them, never added to the stay's bill)
  price         Float           @default(0)
  /// stay | night | person | unit
  unit          String          @default("stay")
  /// the rental company that supplies it (kind "extras"), e.g. St Barth Provider
  partnerId     Int?
  partner       ServicePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  /// groups the guest catalog (Baby, Pool, Beach…)
  categoryEn    String?
  categoryFr    String?
  imageUrl      String?
  isActive      Boolean         @default(true)
  /// guests can request it from their portal
  guestBookable Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items ReservationExtra[]
}

/// An extra added to a stay — copied from the catalog (label + price) so
/// later catalog edits never change what was agreed.
model ReservationExtra {
  id               Int         @id @default(autoincrement())
  reservationId    Int
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  extraId          Int?
  extra            Extra?      @relation(fields: [extraId], references: [id], onDelete: SetNull)
  label            String
  quantity         Float       @default(1)
  unitPrice        Float       @default(0)
  /// quantity × unitPrice, in `currency`
  amount           Float       @default(0)
  currency         String      @default("USD")
  /// supplied and billed by a provider (St Barth Provider…): shown to the
  /// guest but never added to what they owe the villa
  paidToProvider   Boolean     @default(false)
  /// requested | confirmed | declined (concierge only) | cancelled
  status           String      @default("requested")
  /// day the service is wanted, when it matters
  serviceDate      DateTime?
  notes            String?
  requestedByGuest Boolean     @default(false)
  /// extra (a service billed with the stay) | concierge (a table, boat or chef
  /// the owner books with the provider for the guest)
  kind             String      @default("extra")
  /// concierge: restaurant | boat | chef
  category         String?
  /// concierge: time wanted, HH:MM
  serviceTime      String?
  /// concierge: number of people (PAX)
  guests           Int?
  /// concierge: the owner's answer, shown to the guest (table under which name, why declined…)
  adminNote        String?
  /// last time the owner answered (status or note changed) — the portal
  /// highlights the request until the guest has seen it
  answeredAt       DateTime?
  guestSeenAt      DateTime?
  /// the map place a concierge table request is for — gives the guest a
  /// "Directions" link to it on the island map
  placeId          Int?
  place            MapPlace?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([reservationId])
}

/// A change of dates on a stay: asked by the guest from the portal (pending
/// until the owner approves or rejects it) or made by the owner in the editor.
/// The next contract issued for the stay becomes an amendment that releases
/// the previous dates.
model DateChange {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  /// guest | admin
  source        String      @default("guest")
  /// pending | approved | rejected | cancelled
  status        String      @default("pending")
  /// the stay's dates when the change was asked
  fromStart     DateTime
  fromEnd       DateTime
  toStart       DateTime
  toEnd         DateTime
  /// rent TTC (USD) before the change
  previousTTC   Float       @default(0)
  /// estimated rent TTC for the new dates (null when it can't be estimated)
  quotedTTC     Float?
  message       String?
  /// owner's reply, shown to the guest
  adminNote     String?
  decidedAt     DateTime?
  decidedBy     String?
  /// the amendment issued for this change
  contractId    Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([reservationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────── Automations

/// One row per automatic message already handled for a stay, so a reminder
/// is never sent twice (the unique key is the claim).
model ReminderLog {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  /// option_expiring | option_expired | balance_due | balance_overdue | pre_arrival | review_request
  kind          String
  sentAt        DateTime    @default(now())

  @@unique([reservationId, kind])
}

// ───────────────────────────────────────────────────────────── Date pricing

/// A dated rate override (regatta week, carnival, a quiet fortnight…). Nights
/// inside the range use it instead of the season rate.
model RatePeriod {
  id            Int      @id @default(autoincrement())
  name          String
  /// first night
  startDate     DateTime
  /// last night (inclusive)
  endDate       DateTime
  /// fixed | percent
  mode          String   @default("fixed")
  /// weekly USD per bedrooms in use (mode fixed)
  rate2         Float?
  rate3         Float?
  rate4         Float?
  /// +/- % on the season rate (mode percent)
  adjustPercent Float?
  /// minimum nights for a stay touching the period
  minStay       Int?
  isActive      Boolean  @default(true)
  showOnWebsite Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────────────────── Booking requests

/// Inquiry submitted from the public booking module.
model BookingRequest {
  id                 Int          @id @default(autoincrement())
  startDate          DateTime
  endDate            DateTime
  bedrooms           Int          @default(4)
  guests             Int          @default(8)
  name               String
  email              String
  phone              String?
  message            String?
  language           String       @default("en")
  /// quote shown to the guest at submission time (JSON snapshot)
  quoteJson          String?
  promoCode          String?
  /// new | answered | converted | declined
  status             String       @default("new")
  adminNotes         String?
  reservationId      Int?         @unique
  reservation        Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  /// the site visit the request was sent from (Analytique → attribution)
  analyticsSessionId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────── Contracts

model Contract {
  id              Int         @id @default(autoincrement())
  reservationId   Int
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  token           String      @unique
  /// pending | signed | expired | void
  status          String      @default("pending")
  language        String      @default("en")
  clientName      String
  clientEmail     String?
  totalPrice      Float
  depositAmount   Float
  /// contract | amendment (replaces an earlier agreement after a change of dates)
  kind            String      @default("contract")
  /// contract body snapshot (HTML) at generation time
  bodyHtml        String
  /// JSON snapshot of the terms the contract was issued with (dates, price,
  /// amounts received, released dates) — the PDF is rebuilt from it, so a
  /// later change to the stay never rewrites an agreement already issued
  termsJson       String?
  signatureData   String? // data-URL PNG drawn by the client
  signedAt        DateTime?
  signerIp        String?
  signerUserAgent String?
  pdfPath         String?
  viewCount       Int         @default(0)
  firstViewedAt   DateTime?
  lastViewedAt    DateTime?
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())

  @@index([reservationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────── Loyalty

model LoyaltyAccount {
  id             Int      @id @default(autoincrement())
  clientId       Int      @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  points         Int      @default(0)
  /// lifetime earned points (never decreases — drives tier)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id            Int            @id @default(autoincrement())
  accountId     Int
  account       LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// earn | redeem | adjust | expire
  kind          String
  points        Int
  reason        String?
  reservationId Int?
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdBy     String?
  createdAt     DateTime       @default(now())

  @@index([accountId])
}

// ──────────────────────────────────────────────────────────────── Promotions

model Promotion {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  /// percent | fixed | free_nights
  discountType    String    @default("percent")
  discountValue   Float     @default(0)
  minNights       Int?
  maxNights       Int?
  validFrom       DateTime?
  validUntil      DateTime?
  stayStartFrom   DateTime?
  stayStartUntil  DateTime?
  mustIncludeDate DateTime?
  promoCode       String?
  isActive        Boolean   @default(true)
  priority        Int       @default(0)
  firstTimeOnly   Boolean   @default(false)
  showOnWebsite   Boolean   @default(false)
  maxUses         Int?
  usedCount       Int       @default(0)
  combinable      Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
}

// ────────────────────────────────────────────────────────────────── Expenses

model Expense {
  id          Int       @id @default(autoincrement())
  date        DateTime
  /// jardinier | electricite | eau | menage | piscine | entretien | assurance | taxe | internet | autre
  category    String    @default("autre")
  amount      Float
  currency    String    @default("EUR")
  description String?
  notes       String?
  isFixed     Boolean   @default(false)
  /// monthly | bimonthly | quarterly | yearly
  frequency   String?
  endDate     DateTime?
  paymentDay  Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([date])
  @@index([category])
}

// ────────────────────────────────────────────────────────────── Site content

model Photo {
  id        Int      @id @default(autoincrement())
  /// pool-terrace | living | kitchen | bedroom1..4 | night | exterior
  category  String
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
}

model Testimonial {
  id         Int       @id @default(autoincrement())
  name       String
  country    String?
  rating     Int       @default(5)
  message    String
  language   String    @default("en")
  isApproved Boolean   @default(false)
  isFeatured Boolean   @default(false)
  stayDate   DateTime?
  createdAt  DateTime  @default(now())
}

/// A pin on the public island map (/map): beaches, restaurants, shops…
/// Ported from the legacy PHP map.php + restaurants table.
model MapPlace {
  id                   Int                @id @default(autoincrement())
  slug                 String             @unique
  /// beach | restaurant | supermarket | bakery | pharmacy | transport | sport
  category             String
  /// icon variant inside the category — restaurants: restaurant | beach_club |
  /// lounge | snack | nightlife; transport: gas | airport | ferry | info;
  /// sport: gym | court. Empty = the category's default icon.
  kind                 String?
  name                 String
  /// the village / area, shown next to the name (Gustavia, Saint-Jean…)
  zone                 String?
  lat                  Float
  lng                  Float
  descriptionEn        String?
  descriptionFr        String?
  /// approximate drive time from the villa, in minutes
  driveMinutes         Int?
  /// via-points the driving route must pass through, in order, as
  /// "lat,lng|lat,lng" — St Barth's one-way lanes and hidden turn-offs make
  /// the router's shortest path wrong for some places
  waypoints            String?
  /// the last via-point is where you park; the rest of the way is on foot
  /// (drawn as a dashed walking line)
  walkFromLastWaypoint Boolean            @default(false)
  website              String?
  phone                String?
  // restaurants: what the guest portal's concierge shows
  cuisineEn            String?
  cuisineFr            String?
  /// 1–4 ($ → $$$$)
  priceRange           Int?
  imageUrl             String?
  /// concierge (we book the table) | direct (the guest books online at
  /// bookingUrl) | none (walk-in only). Null = not offered in the portal.
  bookingMode          String?
  bookingUrl           String?
  /// the venue's own contacts, for the owner booking a table
  whatsapp             String?
  email                String?
  reservationExtras    ReservationExtra[]
  sortOrder            Int                @default(0)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([category, isActive])
}

// ───────────────────────────────────────────────────────────────── Concierge

/// A provider the concierge books with: a boat charter company or a private
/// chef. Ported from the legacy boat_partners + chef_partners tables.
model ServicePartner {
  id          Int      @id @default(autoincrement())
  /// boat | chef | extras (equipment rental)
  kind        String
  name        String
  contactName String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  location    String?
  notes       String?
  /// the currency of this provider's prices (USD | EUR) — shown as given,
  /// never added to the stay's bill automatically
  currency    String   @default("EUR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boats      Boat[]
  chefOffers ChefOffer[]
  extras     Extra[]

  @@unique([kind, name])
}

/// Island taxi drivers the guest portal lists (call / WhatsApp).
model Taxi {
  id           Int      @id @default(autoincrement())
  name         String
  /// dialable, international format
  phone        String
  /// as shown to guests ("06 90 …")
  displayPhone String?
  zone         String?
  hasWhatsapp  Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A boat guests can ask the concierge to charter. Prices are indicative,
/// in the partner's currency; empty = not offered for that outing.
model Boat {
  id                  Int             @id @default(autoincrement())
  slug                String          @unique
  partnerId           Int?
  partner             ServicePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  name                String
  boatType            String?
  capacity            Int             @default(10)
  /// as displayed ("55'")
  length              String?
  descriptionEn       String?
  descriptionFr       String?
  includesEn          String?
  includesFr          String?
  imageUrl            String?
  priceHalfDay        Float?
  priceFullDay        Float?
  priceSunset         Float?
  priceCruisingDay    Float?
  priceTransfer       Float?
  transferSbhSxmDay   Float?
  transferSbhSxmNight Float?
  transferSxmSbhDay   Float?
  transferSxmSbhNight Float?
  transferAnguilla    Float?
  isActive            Boolean         @default(true)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

/// A private-chef formula (dinner menu, brunch, buffet, weekly service…).
model ChefOffer {
  id               Int             @id @default(autoincrement())
  slug             String          @unique
  partnerId        Int?
  partner          ServicePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  name             String
  /// dinner | brunch | buffet | cocktail | weekly_chef
  category         String
  formulaName      String?
  /// indicative, in the partner's currency; null = on quote
  price            Float?
  /// per_person | per_day | quote
  priceType        String          @default("per_person")
  minimumGuests    Int             @default(4)
  /// "3h included", "staff not included"…
  duration         String?
  descriptionEn    String?
  descriptionFr    String?
  menuEn           String?
  menuFr           String?
  /// internal, never shown to guests
  notes            String?
  imageUrl         String?
  webPageUrl       String?
  holidaySurcharge Boolean         @default(false)
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Setting {
  key   String @id
  value String
}

model EmailLog {
  id             Int      @id @default(autoincrement())
  templateSlug   String?
  recipientEmail String
  recipientName  String?
  subject        String?
  body           String?
  reservationId  Int?
  clientId       Int?
  /// sent | queued | failed
  status         String   @default("sent")
  errorMessage   String?
  sentAt         DateTime @default(now())

  @@index([sentAt])
}

// ──────────────────────────────────────────────────────────────── Analytics
//
// First-party audience measurement for the public site (Admin → Analytique).
// No third party sees a visitor: the location comes from an offline database
// on this server and raw IP addresses are never stored. Rows older than
// 25 months are purged (CNIL audience-measurement exemption).

/// A browser, recognised by the first-party `ov_vid` cookie (13 months).
model AnalyticsVisitor {
  id           String   @id
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  sessions     Int      @default(0)
  pageviews    Int      @default(0)
  /// how they first found the site
  firstChannel String?
  firstSource  String?
  country      String?
  city         String?
  legacy       Boolean  @default(false)

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

/// One visit: a visitor's pages until 30 minutes of inactivity, or until
/// they come back through another campaign/source.
model AnalyticsSession {
  id               String   @id
  visitorId        String
  isNewVisitor     Boolean  @default(true)
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  pageviews        Int      @default(0)
  /// time the page was actually visible and in use, summed over the pages
  engagedSec       Int      @default(0)
  entryPath        String
  exitPath         String
  referrer         String?
  referrerHost     String?
  /// search | ai | social | agency | email | paid | referral | direct
  channel          String   @default("direct")
  /// google, chatgpt, wimco, instagram…
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  /// gclid | msclkid | fbclid…
  clickIdType      String?
  locale           String?
  language         String?
  country          String?
  region           String?
  city             String?
  /// mobile | tablet | desktop
  device           String?
  browser          String?
  os               String?
  screenWidth      Int?
  /// a booking request was sent during this visit
  converted        Boolean  @default(false)
  bookingRequestId Int?
  legacy           Boolean  @default(false)

  @@index([startedAt])
  @@index([visitorId])
  @@index([lastSeenAt])
}

model AnalyticsPageview {
  id         Int      @id @default(autoincrement())
  sessionId  String
  visitorId  String
  /// path without the /fr prefix, so both languages add up per page
  path       String
  locale     String?
  title      String?
  createdAt  DateTime @default(now())
  engagedSec Int      @default(0)
  /// deepest scroll reached, in %
  scrollPct  Int      @default(0)

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
}

/// Something a visitor did: quote_view, booking_form_start, booking_request,
/// contact_submit, click_whatsapp, click_email, click_phone, outbound…
model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  sessionId String?
  visitorId String?
  name      String
  path      String?
  /// JSON
  props     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name])
  @@index([sessionId])
}

/// A page fetched by a search engine or AI crawler (they run no JavaScript,
/// so they're logged server-side from their user agent).
model CrawlerHit {
  id        Int      @id @default(autoincrement())
  /// GPTBot, Googlebot, ClaudeBot, PerplexityBot…
  bot       String
  /// ai_search | ai_training | ai_user | search | seo | social | other
  category  String
  /// who runs it: OpenAI, Google, Anthropic…
  operator  String?
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([bot])
}
