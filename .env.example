# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — also switch provider in prisma/schema.prisma):
# DATABASE_URL="postgresql://user:password@host:5432/onlyview"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://onlyviewstbarth.com"

# ── Email (SMTP) — used for booking notifications, portal links, contracts ──
# When unset, emails are logged to the database (EmailLog) instead of sent.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="contact@onlyviewstbarth.com"
# SMTP_FROM_NAME="Villa ONLY VIEW"

# Email address that receives admin notifications (new booking requests…)
# ADMIN_NOTIFY_EMAIL="contact@onlyviewstbarth.com"

# ── iCal export ─────────────────────────────────────────────────────────────
# Secret token protecting the private calendar feed (/api/ical?token=…)
# ICAL_TOKEN="generate-a-long-random-string"
